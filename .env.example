# Credenciais da Cloudflare, usadas por infra/cloudflare-setup.mjs.
# Copie para .env e preencha. O .env real nunca vai para o repositório.

# ID da conta (Cloudflare > Visão geral, coluna da direita).
CLOUDFLARE_ID=

# API token com permissão de Zone:DNS:Edit e Account:Cloudflare Tunnel:Edit.
CLOUDFLARE_API=

# ID da zona do domínio (Cloudflare > o domínio > Visão geral).
CLOUDFLARE_ZONA=

# Caixa que recebe os e-mails encaminhados por infra/finish-email-routing.sh.
EMAIL_DESTINO=

# Chaves de acesso a object storage (R2), se a aplicação vier a usar.
ACCESS_KEY=
ACCESS_KEY_SECRET=

# Senha do painel, usada pelos scripts de auditoria em apps/frontend/audit/.
# Eles não têm valor embutido: uma senha no histórico do Git é permanente.
CORAL_ADMIN_SENHA=

# Senha do PostgreSQL. O docker-compose tem um padrão embutido para o
# ambiente de desenvolvimento; em produção, defina aqui.
POSTGRES_PASSWORD=

# Chave de 32 bytes (hex) que cifra os segredos guardados no banco, como a
# senha do SMTP. Gere com:  openssl rand -hex 32
# Guarde fora da máquina: sem ela, os segredos salvos não são recuperáveis.
CORAL_SECRET_KEY=
